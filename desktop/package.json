{
  "name": "atak-overlay",
  "version": "0.2.0",
  "description": "Map overlay for games",
  "author": "Rhys Evans",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "build": {
    "appId": "com.rhysevans.atakoverlay",
    "productName": "ATAK Overlay",
    "files": ["main.js", "index.html", "frame.png", "milsymbol.js", "symdata.js", "package.json"],
    "directories": { "buildResources": "build" },
    "publish": { "provider": "github", "owner": "rice-evans", "repo": "RO-TAK" },
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.games", "identity": null },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false }
  }
}

{
  "name": "atak-overlay",
  "version": "0.2.0",
  "description": "Map overlay for games",
  "author": "Rhys Evans",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.rhysevans.atakoverlay",
    "productName": "RO-TAK",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "frame.png",
      "milsymbol.js",
      "symdata.js",
      "supabase.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "rice-evans",
      "repo": "RO-TAK"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "afterPack.js"
  }
}
